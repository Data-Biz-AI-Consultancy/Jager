{
  "id": "dapp-connectors-notion-substack",
  "name": "DAPP Connectors - Notion & Substack",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 4
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        112,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DATA_PIPELINE_URL || 'http://dapp-api:8000' }}/run/connectors/notion?mode=vectordb",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.DAPP_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "trigger-notion-connector",
      "name": "Trigger Notion Connector",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        336,
        208
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DATA_PIPELINE_URL || 'http://dapp-api:8000' }}/run/connectors/substack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.DAPP_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "trigger-substack-connector",
      "name": "Trigger Substack Connector",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        336,
        400
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Trigger Notion Connector",
            "type": "main",
            "index": 0
          },
          {
            "node": "Trigger Substack Connector",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  }
}
