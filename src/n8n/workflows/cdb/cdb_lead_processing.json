{
  "id": "cdb-lead-processing-workflow",
  "name": "CDB - Lead Processing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -96
      ],
      "id": "1",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_build_object(\n  'records', COALESCE(json_agg(r), '[]'::json)\n) AS payload\nFROM (\n  SELECT \n    id::text AS page_id,\n    database_id AS database_name,\n    title,\n    to_char(COALESCE(meeting_date, created_time), 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"') AS meeting_date,\n    attendees,\n    COALESCE(transcription, summary, '') AS summary,\n    CASE \n      WHEN action_items IS NOT NULL AND action_items != '' THEN to_json(string_to_array(action_items, E'\\n')) \n      ELSE '[]'::json \n    END AS to_dos,\n    url\n  FROM s_notion.meeting_notes\n) r;",
        "options": {}
      },
      "id": "fetch-notion-meeting-notes",
      "name": "Fetch Notion Meeting Notes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        224,
        -96
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "postgres-db",
          "name": "postgres Credential"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CDB_SERVICE_URL || 'http://cdb-api:8000' }}/api/v1/ingest/notion-meeting-notes",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.CDB_API_KEY || 'production-api-key' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        -96
      ],
      "id": "ingest-notion-meeting-notes",
      "name": "Ingest Notion Meeting Notes"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Notion Meeting Notes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Notion Meeting Notes": {
      "main": [
        [
          {
            "node": "Ingest Notion Meeting Notes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  }
}
