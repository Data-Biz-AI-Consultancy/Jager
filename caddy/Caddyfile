http://jager.n8n.com, http://cdb.com, http://192.168.178.164 {
    # Download the root certificate over plain HTTP to bootstrap trust
    handle /caddy-root.crt {
        root * /data/caddy/pki/authorities/local
        rewrite * /root.crt
        file_server
    }

    # Redirect all other HTTP traffic to HTTPS matching request host
    handle {
        redir https://{host}{uri}
    }
}

http://localhost {
    reverse_proxy n8n:5678
    encode gzip
}

localhost {
    reverse_proxy n8n:5678
    encode gzip
    tls internal
}

jager.n8n.com {
    reverse_proxy n8n:5678
    encode gzip
    tls internal
    log {
        output stdout
        format json
    }
}

cdb.com {
    reverse_proxy cdb-frontend:3000
    encode gzip
    tls internal
    log {
        output stdout
        format json
    }
}

