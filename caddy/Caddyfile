# Prefer HTTP/1.1 + HTTP/2 (HTTP/3 has broken long-lived /rest/push for some clients).
{
	servers {
		protocols h1 h2
	}
}

# Shared snippet: n8n reverse proxy with push-safe headers.
# n8n 2.x validates Origin on /rest/push; EventSource/SSE often omits it, and some
# proxies mangle Host/Origin. Force canonical values so websocket push succeeds.
(n8n_proxy) {
	handle /rest/push* {
		reverse_proxy n8n:5678 {
			flush_interval -1
			header_up Host {host}
			header_up Origin "https://{host}"
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle {
		reverse_proxy n8n:5678 {
			flush_interval -1
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}
}

# Cloudflare Tunnel typically origins to http://caddy:80 — serve n8n here (no HTTPS redirect).
http://jager.n8n.com, http://staging.jager.n8n.com {
	import n8n_proxy
}

http://cdb.com, http://staging.cdb.com, http://api.cdb.com, http://192.168.178.164 {
	handle /caddy-root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	handle {
		redir https://{host}{uri}
	}
}

http://localhost {
	reverse_proxy n8n:5678 {
		flush_interval -1
	}
	encode gzip
}

localhost {
	reverse_proxy n8n:5678 {
		flush_interval -1
	}
	encode gzip
	tls internal
}

# LAN / direct TLS (internal CA) — same push header fix.
jager.n8n.com, staging.jager.n8n.com {
	handle /rest/push* {
		reverse_proxy n8n:5678 {
			flush_interval -1
			header_up Host {host}
			header_up Origin "https://{host}"
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle {
		reverse_proxy n8n:5678 {
			flush_interval -1
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
		encode gzip
	}
	tls internal
	log {
		output stdout
		format json
	}
}

cdb.com, staging.cdb.com {
	handle /api/v1/* {
		reverse_proxy cdb-api:8000
	}
	handle {
		reverse_proxy cdb-frontend:3000
	}
	encode gzip
	tls internal
	log {
		output stdout
		format json
	}
}

api.cdb.com {
	reverse_proxy cdb-api:8000
	encode gzip
	tls internal
	log {
		output stdout
		format json
	}
}
