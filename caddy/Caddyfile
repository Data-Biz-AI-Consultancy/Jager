{
	servers {
		protocols h1 h2
	}
}

# n8n via Caddy (LAN TLS + Cloudflare Tunnel HTTP origin).
# Push uses SSE (N8N_PUSH_BACKEND=sse). EventSource does not send Origin;
# n8n 2.x requires it — inject Origin/X-Forwarded-* here.
# Do NOT set Connection/Upgrade (breaks websocket if ever re-enabled).
# Do NOT gzip /rest/push (buffers the SSE stream).

http://jager.n8n.com, http://staging.jager.n8n.com {
	handle /rest/push* {
		reverse_proxy n8n:5678 {
			flush_interval -1
			header_up Host {host}
			header_up Origin "https://{host}"
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle {
		reverse_proxy n8n:5678 {
			flush_interval -1
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}
}

http://cdb.com, http://staging.cdb.com, http://api.cdb.com, http://192.168.178.164 {
	handle /caddy-root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	handle {
		redir https://{host}{uri}
	}
}

http://localhost {
	reverse_proxy n8n:5678 {
		flush_interval -1
	}
}

localhost {
	reverse_proxy n8n:5678 {
		flush_interval -1
	}
	tls internal
}

jager.n8n.com, staging.jager.n8n.com {
	handle /rest/push* {
		reverse_proxy n8n:5678 {
			flush_interval -1
			header_up Host {host}
			header_up Origin "https://{host}"
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle {
		reverse_proxy n8n:5678 {
			flush_interval -1
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
		encode gzip
	}
	tls internal
	log {
		output stdout
		format json
	}
}

cdb.com, staging.cdb.com {
	handle /api/v1/* {
		reverse_proxy cdb-api:8000
	}
	handle {
		reverse_proxy cdb-frontend:3000
	}
	tls internal
	log {
		output stdout
		format json
	}
}

api.cdb.com {
	reverse_proxy cdb-api:8000
	tls internal
	log {
		output stdout
		format json
	}
}
