# Prefer HTTP/1.1 + HTTP/2. HTTP/3 has broken n8n's long-lived /rest/push
# (SSE/WebSocket) for some Cloudflare Tunnel clients → "Lost connection to the server".
{
	servers {
		protocols h1 h2
	}
}

# Cloudflare Tunnel typically origins to http://caddy:80. Do NOT redirect those
# hosts to HTTPS here — that kills SSE/WebSocket push. Serve n8n on HTTP too.
http://jager.n8n.com, http://staging.jager.n8n.com {
	handle /rest/push* {
		reverse_proxy n8n:5678 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle {
		reverse_proxy n8n:5678 {
			flush_interval -1
		}
	}
}

http://cdb.com, http://staging.cdb.com, http://api.cdb.com, http://192.168.178.164 {
	# Download the root certificate over plain HTTP to bootstrap trust
	handle /caddy-root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}

	# Redirect remaining HTTP traffic to HTTPS matching request host
	handle {
		redir https://{host}{uri}
	}
}

http://localhost {
	reverse_proxy n8n:5678 {
		flush_interval -1
	}
	encode gzip
}

localhost {
	reverse_proxy n8n:5678 {
		flush_interval -1
	}
	encode gzip
	tls internal
}

jager.n8n.com, staging.jager.n8n.com {
	# n8n push (SSE/WebSocket) must NOT be gzip-compressed or buffered.
	handle /rest/push* {
		reverse_proxy n8n:5678 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# All other n8n traffic — gzip is safe for regular request/response
	handle {
		reverse_proxy n8n:5678 {
			flush_interval -1
		}
		encode gzip
	}

	tls internal
	log {
		output stdout
		format json
	}
}

cdb.com, staging.cdb.com {
	# Route API calls to the backend — allows client-side fetch to use relative URLs
	handle /api/v1/* {
		reverse_proxy cdb-api:8000
	}
	# All other traffic goes to the Next.js frontend
	handle {
		reverse_proxy cdb-frontend:3000
	}
	encode gzip
	tls internal
	log {
		output stdout
		format json
	}
}

# Direct API access (for service-to-service calls, e.g. n8n external webhooks)
api.cdb.com {
	reverse_proxy cdb-api:8000
	encode gzip
	tls internal
	log {
		output stdout
		format json
	}
}
