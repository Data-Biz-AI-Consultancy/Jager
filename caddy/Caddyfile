# Prefer HTTP/1.1 + HTTP/2.
{
	servers {
		protocols h1 h2
	}
}

# IMPORTANT: Do NOT set header_up Connection/Upgrade — that breaks Caddy's
# native WebSocket dial to n8n. n8n then sees a plain GET /rest/push without
# req.ws and returns exactly: res.status(401).send('Unauthorized')
# → browser "Lost connection to the server".

# Cloudflare Tunnel origin (http://caddy:80)
http://jager.n8n.com, http://staging.jager.n8n.com {
	reverse_proxy n8n:5678 {
		flush_interval -1
		header_up Host {host}
		header_up Origin "https://{host}"
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
	}
}

http://cdb.com, http://staging.cdb.com, http://api.cdb.com, http://192.168.178.164 {
	handle /caddy-root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	handle {
		redir https://{host}{uri}
	}
}

http://localhost {
	reverse_proxy n8n:5678 {
		flush_interval -1
	}
}

localhost {
	reverse_proxy n8n:5678 {
		flush_interval -1
	}
	tls internal
}

# LAN / direct TLS (internal CA) — used from 192.168.x clients
jager.n8n.com, staging.jager.n8n.com {
	reverse_proxy n8n:5678 {
		flush_interval -1
		header_up Host {host}
		header_up Origin "https://{host}"
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
	}
	tls internal
	log {
		output stdout
		format json
	}
}

cdb.com, staging.cdb.com {
	handle /api/v1/* {
		reverse_proxy cdb-api:8000
	}
	handle {
		reverse_proxy cdb-frontend:3000
	}
	tls internal
	log {
		output stdout
		format json
	}
}

api.cdb.com {
	reverse_proxy cdb-api:8000
	tls internal
	log {
		output stdout
		format json
	}
}
